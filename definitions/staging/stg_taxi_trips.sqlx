config {
  type: "table",
  schema: "staging",
  description: "Cleaned and standardised NYC taxi trips",
  tags: ["staging", "taxi"],
  assertions: {
    nonNull: ["pickup_datetime", "fare_amount", "vendor_id"],
    rowConditions: [
      "trip_distance > 0",
      "fare_amount > 0"
    ]
  }
}

SELECT
  vendor_id,
  pickup_datetime,
  dropoff_datetime,
  passenger_count,
  trip_distance,
  rate_code,
  store_and_fwd_flag,
  payment_type,
  fare_amount,
  extra,
  mta_tax,
  tip_amount,
  tolls_amount,
  imp_surcharge,
  airport_fee,
  total_amount,
  pickup_location_id,
  dropoff_location_id,
  data_file_year,
  data_file_month,
  TIMESTAMP_DIFF(dropoff_datetime, pickup_datetime, MINUTE) AS trip_duration_minutes
FROM ${ref("tlc_yellow_trips_2022")}
WHERE
  trip_distance > 0
  AND fare_amount > 0
  AND pickup_datetime IS NOT NULL
  AND dropoff_datetime IS NOT NULL
  AND dropoff_datetime > pickup_datetime